{
  "name": "IndieNodes member health",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "weeks",
              "weeksInterval": 1,
              "triggerAtDay": [1],
              "triggerAtHour": 6,
              "triggerAtMinute": 0
            }
          ]
        }
      },
      "id": "e1be89d3-e23b-44aa-aec0-9a80ad20781a",
      "name": "Weekly Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300],
      "notes": "An hour ahead of member-health-scheduled.yml's own 0 7 * * 1 fallback cron, so that fallback stays a fallback rather than a race."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.github.com/repos/XTREEMMAK/indienodes-ring/actions/workflows/member-health-scheduled.yml/dispatches",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Accept", "value": "application/vnd.github+json" },
            { "name": "X-GitHub-Api-Version", "value": "2022-11-28" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"ref\": \"main\", \"inputs\": { \"resume_url\": $execution.resumeUrl } } }}",
        "options": {}
      },
      "id": "3cde4dcd-a7df-465a-9d59-1bbc6391d104",
      "name": "Dispatch member-health-scheduled.yml",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_ME",
          "name": "GitHub PAT - indienodes-ring (Actions RW)"
        }
      },
      "notes": "Header credential: name 'Authorization', value 'Bearer <fine-grained PAT scoped to indienodes-ring, Actions: read/write>'."
    },
    {
      "parameters": {
        "resume": "webhook",
        "limitWaitTime": true,
        "limitType": "afterTimeInterval",
        "resumeAmount": 20,
        "resumeUnit": "minutes",
        "options": {}
      },
      "id": "a73db664-7fa5-4871-a281-3726315c4ad7",
      "name": "Wait for health.json",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "webhookId": "0a48beb9-b75c-4423-b85e-c09c37f972b7",
      "position": [680, 300]
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body ?? $input.first().json;\nconst staticData = $getWorkflowStaticData('global');\nstaticData.streaks = staticData.streaks || {};\n\nconst alerts = [];\nfor (const r of (body.results || [])) {\n  const key = r.url;\n  const isBroken = r.outcome === 'broken';\n  const prev = staticData.streaks[key] || 0;\n  const streak = isBroken ? prev + 1 : 0;\n  staticData.streaks[key] = streak;\n  if (streak >= 3) {\n    alerts.push({ url: r.url, reason: r.reason, streak, references: r.references });\n  }\n}\n\nreturn [{ json: { alerts, summary: body.summary } }];"
      },
      "id": "33f0f5e3-9c85-441c-8cff-5757b0b241e1",
      "name": "Track streaks",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 300],
      "notes": "Replaces check-member-links.js's --state file: 3 consecutive 'broken' results for the same URL crosses the alert threshold, any healthy/warning result resets it. State lives in this workflow's own static data, persisted by n8n across executions."
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "4c6c9f1a-2f7e-4e39-9c8a-6f7d6b6e9b1a",
              "leftValue": "={{ $json.alerts.length }}",
              "rightValue": 0,
              "operator": { "type": "number", "operation": "gt" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "4e2703c5-3543-4b16-972a-6980247d8801",
      "name": "Any over threshold?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1120, 300]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "create",
        "message": "={{ $json.alerts.map(a => a.url + \" — \" + a.reason + \" (streak \" + a.streak + \")\").join(\"\\n\") }}",
        "additionalFields": {
          "title": "={{ \"IndieNodes: \" + $json.alerts.length + \" member link(s) broken\" }}",
          "priority": 6
        }
      },
      "id": "abd998d6-cd37-4183-8daa-25e7b3101aca",
      "name": "Alert via Gotify",
      "type": "n8n-nodes-base.gotify",
      "typeVersion": 1,
      "position": [1340, 220],
      "credentials": {
        "gotifyApi": {
          "id": "REPLACE_ME",
          "name": "Gotify API"
        }
      },
      "notes": "Credential: Gotify API. Set 'URL' to your Gotify host and 'App API Token' to an application token from Gotify's Apps tab — the client token field can stay empty, it's only needed for delete/list operations this workflow doesn't use."
    }
  ],
  "connections": {
    "Weekly Trigger": {
      "main": [[{ "node": "Dispatch member-health-scheduled.yml", "type": "main", "index": 0 }]]
    },
    "Dispatch member-health-scheduled.yml": {
      "main": [[{ "node": "Wait for health.json", "type": "main", "index": 0 }]]
    },
    "Wait for health.json": {
      "main": [[{ "node": "Track streaks", "type": "main", "index": 0 }]]
    },
    "Track streaks": {
      "main": [[{ "node": "Any over threshold?", "type": "main", "index": 0 }]]
    },
    "Any over threshold?": {
      "main": [[{ "node": "Alert via Gotify", "type": "main", "index": 0 }], []]
    }
  },
  "pinData": {},
  "settings": {
    "executionOrder": "v1"
  }
}
